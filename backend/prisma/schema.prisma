datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String           @id @default(uuid())
  googleId  String           @unique
  email     String           @unique
  name      String
  avatar    String?
  createdAt DateTime         @default(now())
  emails    ScheduledEmail[]
}

model ScheduledEmail {
  id           String    @id @default(uuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipient    String
  subject      String
  body         String
  sender       String
  sendAt       DateTime
  sentAt       DateTime?
  delaySeconds Int       @default(0)
  hourlyLimit  Int       @default(100)
  status       String    @default("SCHEDULED") // "SCHEDULED", "SENDING", "SENT", "FAILED"
  attempts     Int       @default(0)
  errorMessage String?
  etherealUrl  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([sender])
  @@index([sendAt])
}
