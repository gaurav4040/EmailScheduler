# Server Port
PORT=5000

# Redis Configuration for BullMQ & Hourly Rate Limiter
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Database Connection (PostgreSQL or SQLite)
# PostgreSQL example: postgresql://postgres:postgrespassword@localhost:5432/reachinbox_db?schema=public
# SQLite example: file:./dev.db
DATABASE_URL=file:./dev.db

# Authentication (Google OAuth 2.0 & JWT)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
JWT_SECRET=reachinbox_super_secret_jwt_key_2026

# Worker Concurrency & Rate Limiting Defaults
WORKER_CONCURRENCY=5
DEFAULT_MAX_EMAILS_PER_HOUR=100
DEFAULT_MIN_DELAY_SECONDS=2

# Ethereal Email Credentials (Optional: auto-generated if left blank)
ETHEREAL_USER=
ETHEREAL_PASS=
